(footprint "SW_Choc_V1V2_Hotswap_EC11_Combo"
	(version 20260206)
	(generator "pcbnew")
	(generator_version "10.0")
	(layer "F.Cu")
	(descr "Kailh Choc V1/V2 hotswap position that alternatively takes an Alps EC11E encoder with push switch (knob on key centre), Keebart-style: the Choc footprint (kiswitch SW_Hotswap_Kailh_Choc_V1V2_1.00u) is untouched and the EC11 legs are bent outward: A/C/B row 0.75 mm out to 8.25 mm, mounting tabs 2.5 mm out to +/-8 mm. Pin offsets per ceoloide/ergogen-footprints (MIT). Solder either the socket or the encoder, not both. Per-key LED only at 0,+4.7 (between the key and the A/C/B row).")
	(tags "EC11 EC11E Encoder Combo Kailh Choc Keyswitch Switch CPG1350 V1 CPG1353 V2 Hotswap Cutout Keycap 1.00u")
