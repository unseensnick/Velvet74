* text=auto

# Shell scripts and git hooks must run under bash on any OS, so never check them out with CRLF.
*.sh text eol=lf
.githooks/* text eol=lf

# KiCad on Windows saves boards with CRLF. Checking these out as CRLF keeps the working files CRLF and
# stops the "CRLF will be replaced by LF" warning; committed blobs stay LF (text normalisation).
*.kicad_* text eol=crlf
fp-lib-table text eol=crlf
sym-lib-table text eol=crlf
# Large and machine-written, so GitHub collapses them in PR diffs. Local git diff is unaffected.
*.kicad_pcb linguist-generated=true

# 3D models: STEP is text but unreadable as a diff; keep its line-ending handling, drop the diff.
*.step -diff
*.wrl text
*.zip binary
