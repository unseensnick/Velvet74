#!/usr/bin/env bash
# my-soffle commit-message standard (see .claude/rules/workflow.md).
# Rejects a commit whose message breaks the standard. Tracked here as the source of
# truth; activate on a clone with:  git config core.hooksPath .githooks
msg_file="$1"
subject=$(sed -n '1p' "$msg_file")
msg=$(cat "$msg_file")
errors=()

# Let rebase / merge / revert tooling and fixup / squash through untouched.
case "$subject" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

# 1) Conventional subject: type(scope): summary
echo "$subject" | grep -qE '^(feat|fix|docs|chore|refactor|test|perf|build|ci|style|revert)(\([a-z0-9/._ -]+\))?: .+' \
  || errors+=("subject must be 'type(scope): summary' (feat|fix|docs|chore|refactor|test|perf|build|ci|style|revert)")

# 2) Subject <= 72 chars
[ "${#subject}" -le 72 ] || errors+=("subject is ${#subject} chars (max 72)")

# 3) No em dash anywhere in the message
echo "$msg" | grep -q '—' && errors+=("contains an em dash; use commas, parentheses, periods, or colons")

# 4) No AI watermark. A human co-author is fine: GitHub adds one when a review suggestion is committed.
echo "$msg" | grep -qiE 'co-authored-by:.*(claude|anthropic)|generated with|claude\.ai/code|🤖' \
  && errors+=("contains an AI watermark (Co-Authored-By / Generated with / robot emoji)")

# 5) No BARE '#<number>': GitHub auto-links it to an issue or PR of this repo, which is rarely what was
#    meant. An explicit owner/repo#N is allowed. Strip those first, then flag a remaining #<digits>
#    ending at a non-alphanumeric (so a hex colour like #0058A0 is not a false positive).
stripped=$(echo "$msg" | sed -E 's@[A-Za-z0-9._-]+/[A-Za-z0-9._-]+#[0-9]+@@g')
echo "$stripped" | grep -qE '#[0-9]+([^0-9A-Za-z]|$)' \
  && errors+=("bare '#<number>' is ambiguous; link a real issue or PR as 'unseensnick/my-soffle#N'")

if [ "${#errors[@]}" -gt 0 ]; then
  {
    echo ""
    echo "x Commit rejected: message breaks the my-soffle standard (.claude/rules/workflow.md):"
    for e in "${errors[@]}"; do echo "    - $e"; done
    echo ""
    echo "  Subject: $subject"
    echo ""
  } >&2
  exit 1
fi
exit 0
